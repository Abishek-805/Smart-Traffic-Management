# Smart Traffic Management System - Environment Variables Configuration Example
# Copy this file to '.env' before starting services outside Docker:
# copy .env.example .env (Windows PowerShell / CMD)
# cp .env.example .env (Linux / macOS)

# Service Host & Ports
HOST=0.0.0.0
PORT=8000
APP_BACKEND_PORT=8000
WEBSOCKET_SERVER_PORT=8001

# Redis Configuration (Pub/Sub & Event Bus)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Application Debug & Logging Mode
DEBUG=true

# AI & YOLO Model Configuration
YOLO_MODEL_NAME=yolo11n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_DEVICE=auto

# Web UI SCADA Frontend Configuration
VITE_API_BASE=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8001/ws/telemetry
VITE_CAMERA_WS_URL=ws://localhost:8001/ws/camera
VITE_BACKEND_TARGET=http://localhost:8000
