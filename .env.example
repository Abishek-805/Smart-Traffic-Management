# Copy to root .env for run.py. Leave public host unset for LAN IP detection.
# CAMERA_PUBLIC_HOST=192.168.1.100
# run.py derives the camera WebSocket port from --port (default 8000).
# Split/Docker deployments use CAMERA_WS_PORT=8001.
CAMERA_WS_SECURE=false
REDIS_URL=redis://localhost:6379
YOLO_MODEL_NAME=yolo26s.pt
YOLO_CONFIDENCE_THRESHOLD=0.08
YOLO_IOU=0.60
YOLO_INPUT_SIZE=640
YOLO_MAX_DETECTIONS=300
YOLO_CPU_THREADS=4
YOLO_DEVICE=auto
TRACK_HIGH_THRESHOLD=0.15
TRACK_LOW_THRESHOLD=0.08
NEW_TRACK_THRESHOLD=0.15
TRACK_BUFFER_FRAMES=12
TRACK_MATCH_THRESHOLD=0.80

# Raspberry Pi 5 CPU after exporting the model on the Pi:
# YOLO_MODEL_NAME=models/yolo26n_ncnn_model
# YOLO_INPUT_SIZE=640
# YOLO_CPU_THREADS=4

# For Vite development, put these in web-ui/.env.local or the shell environment.
VITE_API_BASE=/api/v1
VITE_WS_URL=/ws/telemetry
VITE_CAMERA_WS_URL=/ws/camera
VITE_BACKEND_TARGET=http://localhost:8000
# The local default is the combined runtime on 8000. Override with 8001 only
# when running the Docker/split WebSocket service.
VITE_WS_TARGET=ws://localhost:8000
