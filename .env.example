# =====================================================================
# Smart Traffic Management System - Environment Configuration (.env)
# Copy this file to .env before starting the server.
# =====================================================================

# --- Server & Network Settings ---
# Explicit LAN host IP for camera nodes (leave commented out for automatic LAN IP detection)
# CAMERA_PUBLIC_HOST=192.168.1.100

# Camera WebSocket port
# Combined runtime (run.py default): 8000
# Split Docker runtime (websocket-server): 8001
CAMERA_WS_PORT=8000
CAMERA_WS_SECURE=false

# Redis connection URL (used in Docker split deployment or multi-process caching)
REDIS_URL=redis://localhost:6379

# --- Target Deployment Profile ---
# Options: 'laptop' (default, multi-core CPU) or 'raspberry_pi' (resource-bounded edge SBC)
TRAFFIC_PROFILE=laptop

# --- Hardware Traffic Controller ---
# Options: 'simulation' (default, internal virtual controller) or 'esp32' (physical UART microcontroller)
HARDWARE=simulation
# ESP32 Serial Port (Required when HARDWARE=esp32. E.g., 'COM3' on Windows, '/dev/ttyUSB0' on Linux)
# ESP32_PORT=COM3
ESP32_BAUDRATE=115200

# --- YOLO Vision Detector Configuration ---
# Model weights file or path (e.g. 'yolov8n.pt' or 'models/yolov8n.onnx')
YOLO_MODEL_NAME=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.08
YOLO_IOU=0.60
# Input image size (default: 576 for laptop profile, 512 for raspberry_pi)
YOLO_INPUT_SIZE=576
YOLO_MAX_DETECTIONS=300
YOLO_CPU_THREADS=4
YOLO_BATCH_SIZE=4
# Execution device: 'auto', 'cpu', 'cuda', or 'mps'
YOLO_DEVICE=auto

# --- Tracking Configuration (ByteTrack) ---
TRACK_HIGH_THRESHOLD=0.15
TRACK_LOW_THRESHOLD=0.08
NEW_TRACK_THRESHOLD=0.15
TRACK_BUFFER_FRAMES=12
TRACK_MATCH_THRESHOLD=0.80

# --- Stream & Frame Cadence Overrides (Optional, defaults from TRAFFIC_PROFILE) ---
# CAMERA_CAPTURE_FPS=4.0
# WEBRTC_SAMPLE_FPS=4.0
# DETECTOR_FPS=2.0
# PREVIEW_FPS=4.0

# --- Local Offline Video Sources (Optional simulation fixtures) ---
# TRAFFIC_NORTH_SOURCE=videos/north.mp4
# TRAFFIC_SOUTH_SOURCE=videos/south.mp4
# TRAFFIC_EAST_SOURCE=videos/east.mp4
# TRAFFIC_WEST_SOURCE=videos/west.mp4

# --- Web UI Development (web-ui/.env.local or frontend dev server) ---
VITE_API_BASE=/api/v1
VITE_WS_URL=/ws/telemetry
VITE_CAMERA_WS_URL=/ws/camera
VITE_BACKEND_TARGET=http://localhost:8000
# For split deployment, set VITE_WS_TARGET to ws://localhost:8001
VITE_WS_TARGET=ws://localhost:8000
