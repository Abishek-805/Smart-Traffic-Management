{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-traffic.local/schemas/evaluation-manifest.schema.json",
  "title": "Smart Traffic Model Evaluation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "annotation_file", "datasets"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "annotation_file": {"type": "string", "minLength": 1},
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset_id", "split", "provenance", "source", "license", "annotation_revision", "sha256", "scene_tags"],
        "properties": {
          "dataset_id": {"type": "string", "minLength": 1},
          "split": {"type": "string", "minLength": 1},
          "provenance": {"enum": ["external", "project_owned"]},
          "source": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "annotation_revision": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "scene_tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    }
  }
}
